# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform JavaScript & Places APIs.
# AI Studio automatically injects this at runtime when Maps is provisioned.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
